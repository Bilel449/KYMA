{%- comment -%}
  KYMA — en-tête de section façon charte : « 01 / label / titre avec mot en italique / texte ».

  Paramètres :
    number     : ex. '01'
    label      : ex. 'Manifeste'
    before     : début du titre
    em         : mot en italique (marron clair foncé)
    after      : fin du titre
    text       : texte d'introduction (les retours à la ligne sont conservés)
    heading_id : id HTML du titre (pour aria-labelledby)
{%- endcomment -%}
{%- if number != blank -%}<p class="kyma-sec__num">{{ number | escape }}</p>{%- endif -%}
{%- if label != blank -%}<p class="kyma-sec__label">{{ label | escape }}</p>{%- endif -%}
{%- if before != blank or em != blank or after != blank -%}
  <h2 class="kyma-sec__title"{% if heading_id != blank %} id="{{ heading_id }}"{% endif %}>
    {{- before | escape -}}
    {%- if em != blank %} <em>{{ em | escape }}</em>{% endif -%}
    {%- if after != blank -%}
      {%- assign after_first = after | strip | slice: 0, 1 -%}
      {%- unless '.,;:!?)' contains after_first %} {% endunless -%}
      {{- after | strip | escape -}}
    {%- endif -%}
  </h2>
{%- endif -%}
{%- if text != blank -%}<p class="kyma-sec__desc">{{ text | escape | newline_to_br }}</p>{%- endif -%}
