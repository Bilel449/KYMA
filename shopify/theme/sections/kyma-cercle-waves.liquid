{%- comment -%}
  KYMA — Cercle Waves : deux paliers (INITIUM / ORIGINE) en cartes qui pivotent (cahier des charges § 4).
  Rendu principal en CSS 3D (preserve-3d) : le texte reste du vrai texte, net, sélectionnable et lu par les
  lecteurs d'écran ; aucun contexte WebGL de plus. Reflet satiné en CSS qui suit le pointeur (balayage lent
  toutes les 7 s sans pointeur), inclinaison ±8° lissée, ombre de contact qui s'élargit quand la carte monte.
  Déclencheurs (kyma-pages.js) : survol 120 ms -> pivote, sortie 400 ms -> revient ; clic = épingle ;
  toucher = bascule, glisser horizontal = la carte suit le doigt puis s'accroche ; clavier : Tab, Entrée /
  Espace = bascule, Échap = recto. Zone sensible fixe (le <li>), indépendante de la rotation.
  Option : deux anneaux 3D (scène « rings », contexte WebGL partagé) qui se rapprochent au défilement.
  AUCUN PRIX. Avantages et conditions : [À COMPLÉTER] tant que le fondateur n'a pas décidé.
{%- endcomment -%}
{% render 'kyma-assets' %}
{%- assign title_id = 'kyma-cw2-title-' | append: section.id -%}

<section id="{{ section.settings.anchor | default: title_id }}" class="kyma-sec kyma-cercle{% if section.settings.compact_top %} kyma-cercle--tight{% endif %}" aria-labelledby="{{ title_id }}" data-kyma-rings{% if section.settings.show_rings %} data-kyma-rings-scroll="join"{% endif %}>
  <div class="kyma-sec__inner">
    <div class="kyma-cercle__head" data-kyma-reveal>
      {% render 'kyma-section-head',
        number: section.settings.number,
        label: section.settings.label,
        before: section.settings.title_before,
        em: section.settings.title_em,
        after: section.settings.title_after,
        text: section.settings.text,
        heading_id: title_id
      %}
    </div>

    {%- if section.settings.show_rings -%}
      <div class="kyma-cercle__rings" data-kyma-3d-host data-kyma-reveal>
        <canvas data-kyma-3d="rings" data-follow="false" aria-hidden="true"></canvas>
        <span class="kyma-cercle__ringtag kyma-cercle__ringtag--a" aria-hidden="true">INITIUM</span>
        <span class="kyma-cercle__ringtag kyma-cercle__ringtag--b" aria-hidden="true">ORIGINE</span>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="kyma-cercle__grid" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign face_id = 'kyma-tier-' | append: section.id | append: '-' | append: forloop.index
            assign perk_lines = block.settings.perks | newline_to_br | split: '<br />'
          -%}
          <li
            class="kyma-tier kyma-tier--{{ block.settings.tone }}"
            data-kyma-reveal
            data-kyma-flip
            style="--kd: {{ forloop.index0 | times: 120 }}ms;"
            data-ring="{{ forloop.index0 | at_most: 1 }}"
            {{ block.shopify_attributes }}
          >
            <button type="button" class="kyma-tier__hit" aria-pressed="false" aria-label="{{ block.settings.aria | escape }}"></button>
            <div class="kyma-tier__lift">
              <div class="kyma-flip__tilt">
                <div class="kyma-flip">
                  <div class="kyma-flip__face kyma-flip__front" id="{{ face_id }}-front">
                    <span class="kyma-tier__num">{{ block.settings.number | escape }}</span>
                    <h3 class="kyma-tier__name">{{ block.settings.name | escape }}</h3>
                    <p class="kyma-tier__lead">{{ block.settings.lead | escape }}</p>
                    {%- if block.settings.sub != blank -%}<p class="kyma-tier__sub">{{ block.settings.sub | escape }}</p>{%- endif -%}
                    <svg class="kyma-tier__sym" viewBox="0 0 120 64" aria-hidden="true" focusable="false">
                      {%- if block.settings.symbol == 'two' -%}
                        <circle cx="44" cy="32" r="24"/><circle cx="76" cy="32" r="24"/>
                      {%- else -%}
                        <circle cx="60" cy="32" r="24"/>
                      {%- endif -%}
                    </svg>
                    <span class="kyma-tier__invite" aria-hidden="true">{{ block.settings.invite | escape }}
                      <svg viewBox="0 0 28 12" focusable="false"><path pathLength="1" d="M1 6 C7 2 11 10 17 6 L26 6 M22 2 L26 6 L22 10"/></svg>
                    </span>
                  </div>
                  <div class="kyma-flip__face kyma-flip__back" id="{{ face_id }}-back" aria-hidden="true" inert>
                    <p class="kyma-tier__tag">{{ block.settings.back_label | escape }}</p>
                    <ul class="kyma-tier__perks" role="list">
                      {%- for perk in perk_lines -%}
                        {%- assign perk_clean = perk | strip -%}
                        {%- if perk_clean != blank -%}<li>{{ perk_clean | escape }}</li>{%- endif -%}
                      {%- endfor -%}
                    </ul>
                    {%- if block.settings.condition != blank -%}
                      <p class="kyma-tier__cond">{{ block.settings.condition | escape }}</p>
                    {%- endif -%}
                    {%- if block.settings.cta_label != blank -%}
                      <a class="kyma-btn kyma-tier__cta" href="{{ block.settings.cta_link | default: '#rejoindre' }}" tabindex="-1"><span>{{ block.settings.cta_label | escape }}</span></a>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            </div>
            <span class="kyma-tier__shadow" aria-hidden="true"></span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
      <div class="kyma-cercle__cta" data-kyma-reveal>
        <a class="kyma-btn kyma-btn--ghost" href="{{ section.settings.cta_link }}" data-kyma-magnetic>
          <span>{{ section.settings.cta_label | escape }}</span>
          <span class="kyma-btn__arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "KYMA — Cercle Waves",
  "tag": "div",
  "class": "kyma-section",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancre (id HTML)", "default": "cercle" },
    { "type": "text", "id": "number", "label": "Numéro", "default": "05" },
    { "type": "text", "id": "label", "label": "Label", "default": "CERCLE WAVES" },
    { "type": "text", "id": "title_before", "label": "Titre — début", "default": "Rejoindre le" },
    { "type": "text", "id": "title_em", "label": "Titre — mot en italique", "default": "cercle" },
    { "type": "text", "id": "title_after", "label": "Titre — fin (facultatif)", "default": "." },
    { "type": "textarea", "id": "text", "label": "Texte d'introduction", "default": "Cercle Waves réunit celles et ceux qui suivent KYMA de près. Deux paliers, INITIUM et ORIGINE." },
    { "type": "text", "id": "cta_label", "label": "Bouton — texte", "default": "Entrer dans le Cercle" },
    { "type": "url", "id": "cta_link", "label": "Bouton — URL" },
    { "type": "checkbox", "id": "show_rings", "label": "Afficher les deux anneaux 3D (ils s'entrelacent au défilement)", "default": true },
    { "type": "checkbox", "id": "compact_top", "label": "Espacement réduit en haut", "default": false }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Palier",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "number", "label": "Numéro", "default": "01" },
        { "type": "text", "id": "name", "label": "Nom du palier", "default": "INITIUM" },
        { "type": "text", "id": "lead", "label": "Accroche", "default": "L'entrée dans le cercle." },
        { "type": "text", "id": "sub", "label": "Sous-ligne", "default": "Pour toute personne qui rejoint KYMA." },
        { "type": "select", "id": "symbol", "label": "Symbole", "options": [ { "value": "one", "label": "Un anneau" }, { "value": "two", "label": "Deux anneaux entrelacés" } ], "default": "one" },
        { "type": "select", "id": "tone", "label": "Teinte de la carte", "options": [ { "value": "initium", "label": "Rose clair (INITIUM)" }, { "value": "origine", "label": "Marron clair (ORIGINE)" } ], "default": "initium" },
        { "type": "text", "id": "invite", "label": "Invite au recto", "default": "Retourner" },
        { "type": "text", "id": "back_label", "label": "Verso — intitulé", "default": "AVANTAGES" },
        { "type": "textarea", "id": "perks", "label": "Avantages (un par ligne)", "default": "[À COMPLÉTER : avantage 1, décision du fondateur]\n[À COMPLÉTER : avantage 2]" },
        { "type": "text", "id": "condition", "label": "Condition d'accès / de passage", "default": "Condition d'accès : [À COMPLÉTER : décision du fondateur]" },
        { "type": "text", "id": "cta_label", "label": "Verso — bouton", "default": "Rejoindre le cercle" },
        { "type": "url", "id": "cta_link", "label": "Verso — lien (ancre de l'inscription)" },
        { "type": "text", "id": "aria", "label": "Annonce lecteur d'écran", "default": "INITIUM, carte du palier d'entrée. Activer pour afficher les avantages." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "KYMA — Cercle Waves",
      "blocks": [
        { "type": "tier", "settings": { "number": "01", "name": "INITIUM", "lead": "L'entrée dans le cercle.", "sub": "Pour toute personne qui rejoint KYMA.", "symbol": "one", "tone": "initium" } },
        { "type": "tier", "settings": { "number": "02", "name": "ORIGINE", "lead": "Le palier supérieur.", "sub": "Pour celles et ceux qui portent KYMA depuis ses origines.", "symbol": "two", "tone": "origine", "condition": "Condition de passage : [À COMPLÉTER : critère décidé par le fondateur]", "aria": "ORIGINE, carte du palier supérieur. Activer pour afficher les avantages." } }
      ]
    }
  ]
}
{% endschema %}
