{%- comment -%}
  KYMA — Cercle Waves : 2 paliers (INITIUM / ORIGINE) en cartes qui pivotent en 3D (recto = nom + accroche,
  verso = avantages) au survol, au tap ou au clavier (bouton aria-pressed), avec inclinaison et reflet satiné ;
  + deux anneaux 3D entrelacés
  (kyma-3d.js, scène rings) qui orbitent lentement ; survoler ou focaliser un palier anime son anneau
  (1er palier = anneau rose clair, 2e palier = anneau brun). Décoratif : tout le contenu est dans les cartes.
  Les conditions d'accès et avantages ne sont PAS inventés : champs à compléter.
{%- endcomment -%}
{% render 'kyma-assets' %}
{%- assign title_id = 'kyma-cw2-title-' | append: section.id -%}

<hr class="kyma-divider" data-kyma-reveal>

<section class="kyma-sec kyma-cercle" aria-labelledby="{{ title_id }}" data-kyma-rings>
  <div class="kyma-sec__inner">
    <div data-kyma-reveal>
      {% render 'kyma-section-head',
        number: section.settings.number,
        label: section.settings.label,
        before: section.settings.title_before,
        em: section.settings.title_em,
        after: section.settings.title_after,
        text: section.settings.text,
        heading_id: title_id
      %}
    </div>

    {%- if section.settings.show_rings -%}
      <div class="kyma-cercle__rings" data-kyma-3d-host data-kyma-reveal>
        <canvas data-kyma-3d="rings" data-follow="false" aria-hidden="true"></canvas>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="kyma-cercle__grid" role="list">
        {%- for block in section.blocks -%}
          {%- assign face_id = 'kyma-tier-' | append: section.id | append: '-' | append: forloop.index -%}
          <li
            class="kyma-tier{% if block.settings.dark %} kyma-tier--dark kyma-on-dark{% endif %}"
            data-kyma-reveal
            data-kyma-flip
            style="--kd: {{ forloop.index0 | times: 140 }}ms;"
            data-ring="{{ forloop.index0 | at_most: 1 }}"
            {{ block.shopify_attributes }}
          >
            <div class="kyma-flip__tilt">
              <div class="kyma-flip">
                <div class="kyma-flip__face kyma-flip__front" id="{{ face_id }}-front">
                  {%- if block.settings.tag != blank -%}
                    <p class="kyma-tier__tag">{{ block.settings.tag | escape }}</p>
                  {%- endif -%}
                  <h3 class="kyma-tier__name">{{ block.settings.name | escape }}</h3>
                  {%- if block.settings.lead != blank -%}
                    <p class="kyma-tier__lead">{{ block.settings.lead | escape }}</p>
                  {%- endif -%}
                  <svg class="kyma-tier__rings" viewBox="0 0 72 32" aria-hidden="true" focusable="false"><circle cx="24" cy="16" r="13" fill="none" stroke="currentColor"/><circle cx="48" cy="16" r="13" fill="none" stroke="currentColor"/></svg>
                </div>
                <div class="kyma-flip__face kyma-flip__back" id="{{ face_id }}-back" aria-hidden="true">
                  <p class="kyma-tier__tag">{{ block.settings.back_label | default: 'Avantages' | escape }} — {{ block.settings.name | escape }}</p>
                  {%- assign perk_lines = block.settings.perks | newline_to_br | split: '<br />' -%}
                  <ul class="kyma-tier__perks" role="list">
                    {%- for perk in perk_lines -%}
                      {%- assign perk_clean = perk | strip -%}
                      {%- if perk_clean != blank -%}
                        <li>{{ perk_clean | escape }}</li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                </div>
              </div>
            </div>
            <button type="button" class="kyma-flip__toggle" aria-pressed="false" aria-controls="{{ face_id }}-back"
              data-label-on="{{ block.settings.toggle_back | default: 'Retour' | escape }}" data-label-off="{{ block.settings.toggle_front | default: 'Voir les avantages' | escape }}">
              <svg viewBox="0 0 14 14" aria-hidden="true" focusable="false"><path d="M2 7a5 5 0 0 1 9-3M12 7a5 5 0 0 1-9 3" fill="none" stroke="currentColor"/><path d="M11 1v3H8M3 13v-3h3" fill="none" stroke="currentColor"/></svg>
              <span>{{ block.settings.toggle_front | default: 'Voir les avantages' | escape }}</span>
              <span class="kyma-vh">— {{ block.settings.name | escape }}</span>
            </button>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
      <div class="kyma-cercle__cta" data-kyma-reveal>
        <a class="kyma-btn kyma-btn--ghost" href="{{ section.settings.cta_link }}" data-kyma-magnetic>
          <span>{{ section.settings.cta_label | escape }}</span>
          <span class="kyma-btn__arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    {%- endif -%}
  </div>

  {%- if section.settings.watermark != blank -%}
    <div class="kyma-sec__mark" aria-hidden="true">{{ section.settings.watermark | escape }}</div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "KYMA — Cercle Waves",
  "tag": "div",
  "class": "kyma-section",
  "settings": [
    { "type": "text", "id": "number", "label": "Numéro", "default": "04" },
    { "type": "text", "id": "label", "label": "Label", "default": "Fidélité" },
    { "type": "text", "id": "title_before", "label": "Titre — début", "default": "Cercle" },
    { "type": "text", "id": "title_em", "label": "Titre — mot en italique", "default": "Waves" },
    { "type": "text", "id": "title_after", "label": "Titre — fin (facultatif)" },
    { "type": "textarea", "id": "text", "label": "Texte d'introduction", "default": "Le Cercle Waves accompagne celles et ceux qui suivent le courant, en deux paliers." },
    { "type": "text", "id": "cta_label", "label": "Bouton — texte", "default": "Découvrir le Cercle Waves" },
    { "type": "url", "id": "cta_link", "label": "Bouton — URL" },
    { "type": "text", "id": "watermark", "label": "Chiffre en filigrane", "default": "04" },
    { "type": "checkbox", "id": "show_rings", "label": "Afficher les deux anneaux 3D", "default": true }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Palier",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "tag", "label": "Petite étiquette (ex. Palier 1)" },
        { "type": "text", "id": "name", "label": "Nom du palier", "default": "Initium" },
        { "type": "text", "id": "lead", "label": "Phrase d'accroche" },
        { "type": "textarea", "id": "perks", "label": "Conditions et avantages (un par ligne)" },
        { "type": "checkbox", "id": "dark", "label": "Carte sombre (palier supérieur)", "default": false },
        { "type": "text", "id": "back_label", "label": "Verso — intitulé", "default": "Avantages" },
        { "type": "text", "id": "toggle_front", "label": "Bouton — retourner la carte", "default": "Voir les avantages" },
        { "type": "text", "id": "toggle_back", "label": "Bouton — revenir au recto", "default": "Retour" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "KYMA — Cercle Waves",
      "blocks": [
        {
          "type": "tier",
          "settings": {
            "tag": "Palier 1",
            "name": "Initium",
            "lead": "L'entrée dans le Cercle.",
            "perks": "[À COMPLÉTER : conditions d'accès et avantages INITIUM]",
            "dark": false
          }
        },
        {
          "type": "tier",
          "settings": {
            "tag": "Palier 2",
            "name": "Origine",
            "lead": "Le palier supérieur.",
            "perks": "[À COMPLÉTER : conditions d'accès et avantages ORIGINE]",
            "dark": true
          }
        }
      ]
    }
  ]
}
{% endschema %}
