{%- comment -%}
  KYMA — Bandeau défilant typographique (« L'art du flow · Ride the wave · κύμα · »).
  Sa vitesse et son inclinaison suivent la vitesse de défilement de la page (kyma-motion.js).
  Mouvement réduit : bandeau immobile, texte lisible. Les copies servant à la boucle sont aria-hidden.
{%- endcomment -%}
{% render 'kyma-assets' %}
{%- assign parts = section.settings.text | split: '·' -%}
<div class="kyma-marquee{% if section.settings.dark %} kyma-marquee--dark kyma-on-dark{% endif %}"
  data-kyma-marquee data-speed="{{ section.settings.speed }}" data-direction="{% if section.settings.reverse %}-1{% else %}1{% endif %}" data-kyma-live>
  <p class="kyma-vh">{{ section.settings.text | escape }}</p>
  <div class="kyma-marquee__track" aria-hidden="true">
    <span class="kyma-marquee__item">
      {%- for part in parts -%}
        {%- assign t = part | strip -%}
        {%- if t != blank -%}
          {%- if forloop.index0 == 1 -%}<em>{{ t | escape }}</em>{%- else -%}{{ t | escape }}{%- endif -%}
          <span class="kyma-marquee__sep">·</span>
        {%- endif -%}
      {%- endfor -%}
    </span>
  </div>
</div>

{% schema %}
{
  "name": "KYMA — Bandeau défilant",
  "tag": "div",
  "class": "kyma-section",
  "settings": [
    { "type": "text", "id": "text", "label": "Texte (segments séparés par « · »)", "default": "L'art du flow · Ride the wave · κύμα ·" },
    { "type": "range", "id": "speed", "label": "Vitesse de base", "min": 10, "max": 120, "step": 5, "unit": "px", "default": 45 },
    { "type": "checkbox", "id": "reverse", "label": "Sens inverse", "default": false },
    { "type": "checkbox", "id": "dark", "label": "Fond brun foncé", "default": false }
  ],
  "presets": [
    { "name": "KYMA — Bandeau défilant" }
  ]
}
{% endschema %}
