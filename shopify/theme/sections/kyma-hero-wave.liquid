{%- comment -%}
  KYMA — Hero plein écran avec motif « KYMA Wave » animé (canvas 2D, dessiné par kyma-motion.js).
  Sans JavaScript ou en mouvement réduit : dégradé tonal + image fixe du motif.
{%- endcomment -%}
{% render 'kyma-assets' %}

{%- liquid
  assign color_a = section.settings.color_a | color_to_hex
  assign color_b = section.settings.color_b | color_to_hex
-%}

<section
  id="kyma-hero-{{ section.id }}"
  class="kyma-hero{% if section.settings.height == 'large' %} kyma-hero--large{% endif %}"
  style="--kh-a: {{ color_a }}; --kh-b: {{ color_b }};"
  data-kyma-hero
  data-kyma-live
  data-color-a="{{ color_a }}"
  data-color-b="{{ color_b }}"
  data-speed="{{ section.settings.speed }}"
  data-scale="{{ section.settings.scale }}"
>
  <canvas class="kyma-hero__canvas" aria-hidden="true"></canvas>

  <div class="kyma-hero__inner">
    {%- if section.settings.label != blank -%}
      <p class="kyma-hero__label">{{ section.settings.label | escape }}</p>
    {%- endif -%}

    {%- if section.settings.title_before != blank or section.settings.title_em != blank -%}
      <h2 class="kyma-hero__title">
        {{- section.settings.title_before | escape -}}
        {%- if section.settings.title_em != blank -%}
          {%- if section.settings.em_new_line %}<br>{% else %} {% endif -%}
          <em>{{ section.settings.title_em | escape }}</em>
        {%- endif -%}
        {%- if section.settings.title_after != blank -%}
          {%- assign after_first = section.settings.title_after | strip | slice: 0, 1 -%}
          {%- unless '.,;:!?)' contains after_first %} {% endunless -%}
          {{- section.settings.title_after | strip | escape -}}
        {%- endif -%}
      </h2>
    {%- endif -%}

    {%- if section.settings.subtitle != blank -%}
      <p class="kyma-hero__sub">{{ section.settings.subtitle | escape }}</p>
    {%- endif -%}

    {%- liquid
      assign show_cta1 = false
      assign show_cta2 = false
      if section.settings.cta_label != blank and section.settings.cta_link != blank
        assign show_cta1 = true
      endif
      if section.settings.cta2_label != blank and section.settings.cta2_link != blank
        assign show_cta2 = true
      endif
    -%}
    {%- if show_cta1 or show_cta2 -%}
      <div class="kyma-hero__ctas">
        {%- if show_cta1 -%}
          <a class="kyma-btn" href="{{ section.settings.cta_link }}">
            <span>{{ section.settings.cta_label | escape }}</span>
            <span class="kyma-btn__arrow" aria-hidden="true">&rarr;</span>
          </a>
        {%- endif -%}
        {%- if show_cta2 -%}
          <a class="kyma-btn kyma-btn--ghost" href="{{ section.settings.cta2_link }}">
            <span>{{ section.settings.cta2_label | escape }}</span>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_waves -%}
      {% render 'kyma-wave-lines', class: 'kyma-hero__waves' %}
    {%- endif -%}
  </div>

  {%- if section.settings.watermark != blank -%}
    <div class="kyma-sec__mark kyma-hero__mark" aria-hidden="true" data-kyma-parallax="-0.5">{{ section.settings.watermark | escape }}</div>
  {%- endif -%}
  <span class="kyma-hero__cue" aria-hidden="true"></span>
</section>

{% schema %}
{
  "name": "KYMA — Hero vagues",
  "tag": "div",
  "class": "kyma-section",
  "settings": [
    { "type": "header", "content": "Texte" },
    { "type": "text", "id": "label", "label": "Label (petites capitales)", "default": "DROP 1 — PRÉCOMMANDE" },
    { "type": "text", "id": "title_before", "label": "Titre — début", "default": "Une pièce. Aucune" },
    { "type": "text", "id": "title_em", "label": "Titre — mot en italique", "default": "identique" },
    { "type": "text", "id": "title_after", "label": "Titre — fin (facultatif)", "default": "." },
    { "type": "checkbox", "id": "em_new_line", "label": "Mot en italique sur sa propre ligne", "default": true },
    { "type": "textarea", "id": "subtitle", "label": "Sous-titre", "default": "Le hoodie zippé oversize. Pensé pour que chaque pièce soit unique." },
    { "type": "header", "content": "Boutons" },
    { "type": "text", "id": "cta_label", "label": "Bouton principal — texte", "default": "Choisir mon coloris" },
    { "type": "url", "id": "cta_link", "label": "Bouton principal — lien" },
    { "type": "text", "id": "cta2_label", "label": "Bouton secondaire — texte", "default": "Notre histoire" },
    { "type": "url", "id": "cta2_link", "label": "Bouton secondaire — lien" },
    { "type": "header", "content": "Motif KYMA Wave" },
    { "type": "paragraph", "content": "Deux nuances proches (jamais de contraste extrême). Le motif est différent à chaque visite et ne se répète jamais à l'identique." },
    { "type": "color", "id": "color_a", "label": "Nuance 1", "default": "#F5EDE4" },
    { "type": "color", "id": "color_b", "label": "Nuance 2", "default": "#E9DCE6" },
    { "type": "range", "id": "speed", "label": "Vitesse (0 = image fixe)", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 30 },
    { "type": "range", "id": "scale", "label": "Taille des volutes", "min": 50, "max": 200, "step": 10, "unit": "%", "default": 100 },
    { "type": "header", "content": "Décor" },
    { "type": "text", "id": "watermark", "label": "Chiffre en filigrane", "default": "01" },
    { "type": "checkbox", "id": "show_waves", "label": "Afficher les 3 vagues du logo", "default": true },
    {
      "type": "select",
      "id": "height",
      "label": "Hauteur",
      "options": [
        { "value": "full", "label": "Plein écran" },
        { "value": "large", "label": "Grande (80 %)" }
      ],
      "default": "full"
    }
  ],
  "presets": [
    { "name": "KYMA — Hero vagues" }
  ]
}
{% endschema %}
