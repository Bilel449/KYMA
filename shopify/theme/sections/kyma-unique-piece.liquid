{%- comment -%}
  KYMA — 02 Le motif : section épinglée au défilement (sticky). La caméra 3D plonge dans la surface marbrée
  du motif KYMA Wave pendant que les phrases (blocs « point ») se révèlent l'une après l'autre.
  Mouvement réduit / éditeur : la section n'est plus épinglée, les phrases sont toutes visibles, image fixe.
  Le texte est posé sur des cartes givrées (contraste AA garanti quel que soit le coloris).
{%- endcomment -%}
{% render 'kyma-assets' %}
{%- assign title_id = 'kyma-dive-title-' | append: section.id -%}
{%- assign n = section.blocks.size | at_least: 1 -%}

<section class="kyma-sec kyma-dive" id="kyma-dive-{{ section.id }}" aria-labelledby="{{ title_id }}" data-kyma-dive style="--dive-h: {{ section.settings.length }}vh;">
  <div class="kyma-dive__sticky">
    <div class="kyma-dive__stage" data-kyma-3d-host>
      <canvas data-kyma-3d="hero" data-shift="0,0" data-colorway="{{ section.settings.colorway }}" data-interactive="false" aria-hidden="true"></canvas>
    </div>
    <div class="kyma-dive__ui">
      <div class="kyma-dive__head" data-kyma-reveal>
        {% render 'kyma-section-head',
          number: section.settings.number,
          label: section.settings.label,
          before: section.settings.title_before,
          em: section.settings.title_em,
          after: section.settings.title_after,
          text: section.settings.text,
          heading_id: title_id
        %}
      </div>
      <ol class="kyma-dive__lines" role="list">
        {%- for block in section.blocks -%}
          {%- assign at = forloop.index0 | times: 0.8 | divided_by: n | plus: 0.12 -%}
          <li class="kyma-dive__line" data-at="{{ at }}" {{ block.shopify_attributes }}>
            <div class="kyma-dive__card">
              <span class="kyma-dive__idx">{{ forloop.index | prepend: '0' }} / {{ n | prepend: '0' }}</span>
              <h3>{{ block.settings.title | escape }}</h3>
              {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ol>
    </div>
    <div class="kyma-dive__meter" aria-hidden="true"><span></span></div>
  </div>
</section>

{% schema %}
{
  "name": "KYMA — Motif (plongée)",
  "tag": "div",
  "class": "kyma-section",
  "settings": [
    { "type": "text", "id": "number", "label": "Numéro", "default": "02" },
    { "type": "text", "id": "label", "label": "Label", "default": "Le motif" },
    { "type": "text", "id": "title_before", "label": "Titre — début", "default": "Un motif pensé pour ne pas se" },
    { "type": "text", "id": "title_em", "label": "Titre — mot en italique", "default": "répéter" },
    { "type": "text", "id": "title_after", "label": "Titre — fin", "default": "." },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Le KYMA Wave est un marbré fluide, volutes et tourbillons, toujours tonal. Il capte le rythme des vagues sans chercher à les copier." },
    {
      "type": "select",
      "id": "colorway",
      "label": "Coloris de départ (suit ensuite le coloris choisi en 01)",
      "options": [
        { "value": "kyma", "label": "KYMA — rose clair, beige, marron clair" },
        { "value": "lilac-whirl", "label": "Lilac Whirl" },
        { "value": "ivory-tide", "label": "Ivory Tide" },
        { "value": "silver-drift", "label": "Silver Drift" },
        { "value": "noir-absolu", "label": "Noir Absolu" },
        { "value": "crimson-flow", "label": "Crimson Flow" }
      ],
      "default": "kyma"
    },
    { "type": "range", "id": "length", "label": "Durée de la plongée (hauteur de défilement)", "min": 200, "max": 400, "step": 20, "unit": "vh", "default": 320 }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Phrase",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "Un marbré fluide" },
        { "type": "text", "id": "text", "label": "Texte", "default": "Volutes et tourbillons, toujours tonal." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "KYMA — Motif (plongée)",
      "blocks": [
        { "type": "point", "settings": { "title": "Un marbré fluide", "text": "Volutes et tourbillons, toujours tonal." } },
        { "type": "point", "settings": { "title": "Une impression all-over", "text": "Le motif s'étend sur tout le tissu." } },
        { "type": "point", "settings": { "title": "Une découpe pensée pour varier", "text": "Pensé pour que chaque pièce soit unique." } }
      ]
    }
  ]
}
{% endschema %}
