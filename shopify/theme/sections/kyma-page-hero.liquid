{%- comment -%}
  KYMA — Ouverture de page (Collection, Cercle Waves, Nous connaître, Guide des tailles…).
  Titre H1 révélé ligne par ligne, mot en italique, texte, bouton + mention, et un visuel SANS image :
    wave    = sculpture 3D « La Vague » (V)       cloth   = étoffe 3D qui ondule (E)
    rings   = anneaux INITIUM / MAJESTÉ (A) : MAJESTÉ entre par la droite au défilement
    pattern = motif KYMA Wave plein cadre (E à plat)
    brand   = le nom KYMA en très grand (H1 visible, DM Serif), trois vagues qui se tracent, mention étymologique
              en petit (« du grec κύμα, la vague ») — page Nous connaître (demande du fondateur : le nom, c'est KYMA)
    word    = le mot κύμα tracé au contour puis rempli (SVG ; le H1 reste du texte, lu par les lecteurs d'écran)     tape = mètre ruban qui se déroule (SVG)
  Les canvas 3D partagent le contexte WebGL unique de kyma-3d.js ; ils sont décoratifs (aria-hidden).
{%- endcomment -%}
{% render 'kyma-assets' %}
{%- liquid
  assign tid = 'kyma-ph-' | append: section.id
  assign v = section.settings.visual
  assign scene = ''
  case v
    when 'wave'
      assign scene = 'hero'
    when 'cloth'
      assign scene = 'swatch'
    when 'rings'
      assign scene = 'rings'
    when 'pattern'
      assign scene = 'pattern'
  endcase
-%}
<section
  id="{{ section.settings.anchor | default: tid }}"
  class="kyma-ph kyma-ph--{{ v }}{% if section.settings.align == 'center' %} kyma-ph--center{% endif %}"
  aria-labelledby="{{ tid }}-t"
  data-kyma-ph
  {% if v == 'rings' %}data-kyma-rings-scroll="enter"{% endif %}
>
  {%- if scene != '' -%}
    <div class="kyma-ph__stage" data-kyma-3d-host>
      <canvas
        data-kyma-3d="{{ scene }}"
        data-colorway="{{ section.settings.colorway }}"
        {% if scene == 'hero' %}data-shift="0,0"{% endif %}
        {% if v == 'rings' %}data-follow="false"{% endif %}
        aria-hidden="true"
      ></canvas>
    </div>
  {%- endif -%}

  <div class="kyma-ph__inner">
    <div class="kyma-ph__copy">
      {%- if section.settings.label != blank -%}
        <p class="kyma-ph__label">{{ section.settings.label | escape }}</p>
      {%- endif -%}
      <h1 class="kyma-ph__title{% if v == 'word' %} kyma-vh{% endif %}" id="{{ tid }}-t"{% unless v == 'word' %} data-kyma-split{% endunless %}>
        {{- section.settings.title_before | escape -}}
        {%- if section.settings.title_em != blank %} <em>{{ section.settings.title_em | escape }}</em>{% endif -%}
        {%- if section.settings.title_after != blank -%}
          {%- assign after_first = section.settings.title_after | strip | slice: 0, 1 -%}
          {%- unless '.,;:!?)' contains after_first %} {% endunless -%}
          {{- section.settings.title_after | strip | escape -}}
        {%- endif -%}
      </h1>
      {%- if v == 'brand' -%}
        <svg class="kyma-ph__waves" viewBox="0 0 240 40" aria-hidden="true" focusable="false" data-kyma-trace>
          <path pathLength="1" d="M4 10C34 2 50 18 80 10S126 2 156 10"/><path pathLength="1" d="M4 22C34 14 50 30 80 22S120 14 140 22"/><path pathLength="1" d="M4 34C28 27 44 41 68 34"/>
        </svg>
        {%- if section.settings.etymology != blank -%}
          <p class="kyma-ph__etym" data-kyma-reveal style="--kd: 380ms;">{{ section.settings.etymology | escape | replace: 'κύμα', '<span lang="el">κύμα</span>' }}</p>
        {%- endif -%}
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="kyma-ph__text" data-kyma-reveal style="--kd: 500ms;">{{ section.settings.text | escape | newline_to_br }}</p>
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <div class="kyma-ph__ctas" data-kyma-reveal style="--kd: 700ms;">
          <a class="kyma-btn" href="{{ section.settings.cta_link | default: '#' }}" data-kyma-magnetic>
            <span>{{ section.settings.cta_label | escape }}</span><span class="kyma-btn__arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>
      {%- endif -%}
      {%- if section.settings.note != blank -%}
        <p class="kyma-ph__note" data-kyma-reveal style="--kd: 850ms;">{{ section.settings.note | escape }}</p>
      {%- endif -%}
    </div>

    {%- if v == 'word' -%}
      <div class="kyma-ph__word">{% render 'kyma-kuma', decorative: true %}</div>
    {%- elsif v == 'tape' -%}
      <div class="kyma-ph__tape" aria-hidden="true">
        <svg viewBox="0 0 520 120" xmlns="http://www.w3.org/2000/svg" focusable="false" data-kyma-trace>
          <path pathLength="1" d="M20 70 C20 40 64 40 64 70 C64 96 30 96 30 70 C30 52 52 52 52 70"/>
          <path pathLength="1" d="M64 70 C140 66 200 76 280 68 C360 60 420 74 500 70"/>
          <path pathLength="1" d="M64 86 C140 82 200 92 280 84 C360 76 420 90 500 86"/>
          <path pathLength="1" class="is-fine" d="M90 70 V80 M110 70 V76 M130 70 V80 M150 70 V76 M170 70 V80 M190 70 V76 M210 71 V81 M230 71 V77 M250 70 V80 M270 69 V75 M290 68 V78 M310 67 V73 M330 66 V76 M350 65 V71 M370 65 V75 M390 66 V72 M410 67 V77 M430 68 V74 M450 69 V79 M470 70 V76 M490 70 V80"/>
        </svg>
      </div>
    {%- endif -%}
  </div>

  {%- if section.settings.alt_text != blank and scene != '' -%}
    <p class="kyma-vh">{{ section.settings.alt_text | escape }}</p>
  {%- endif -%}
  {%- if section.settings.caption != blank -%}
    <p class="kyma-ph__caption kyma-caption">{{ section.settings.caption | escape }}</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "KYMA — Ouverture de page",
  "tag": "div",
  "class": "kyma-section",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancre (id HTML, facultatif)" },
    { "type": "text", "id": "label", "label": "Label (petites capitales)", "default": "NOUS CONNAÎTRE" },
    { "type": "text", "id": "title_before", "label": "Titre — début" },
    { "type": "text", "id": "title_em", "label": "Titre — mot en italique", "default": "κύμα" },
    { "type": "text", "id": "title_after", "label": "Titre — fin", "default": "." },
    { "type": "text", "id": "etymology", "label": "Mention étymologique (visuel « nom KYMA »)", "default": "Du grec κύμα, « la vague ». Se prononce « Kouma »." },
    { "type": "textarea", "id": "text", "label": "Texte" },
    { "type": "text", "id": "cta_label", "label": "Bouton — texte" },
    { "type": "url", "id": "cta_link", "label": "Bouton — lien" },
    { "type": "text", "id": "note", "label": "Mention sous le bouton" },
    {
      "type": "select", "id": "visual", "label": "Visuel (sans image)",
      "options": [
        { "value": "none", "label": "Aucun" },
        { "value": "wave", "label": "Sculpture 3D « La Vague »" },
        { "value": "cloth", "label": "Étoffe 3D qui ondule" },
        { "value": "rings", "label": "Anneaux Cercle Waves (3D)" },
        { "value": "pattern", "label": "Motif KYMA Wave plein cadre" },
        { "value": "brand", "label": "Le nom KYMA en grand + mention grecque" },
        { "value": "word", "label": "Le mot κύμα (tracé)" },
        { "value": "tape", "label": "Mètre ruban (tracé)" }
      ],
      "default": "none"
    },
    {
      "type": "select", "id": "colorway", "label": "Palette de la 3D",
      "options": [
        { "value": "kyma", "label": "KYMA — rose clair et beige" },
        { "value": "kyma-camel", "label": "KYMA — marron clair et rose" },
        { "value": "lilac-whirl", "label": "Lilac Whirl" },
        { "value": "ivory-tide", "label": "Ivory Tide" },
        { "value": "silver-drift", "label": "Silver Drift" },
        { "value": "noir-absolu", "label": "Noir Absolu" },
        { "value": "crimson-flow", "label": "Crimson Flow" }
      ],
      "default": "kyma"
    },
    {
      "type": "select", "id": "align", "label": "Mise en page",
      "options": [ { "value": "split", "label": "Texte à gauche, visuel à droite" }, { "value": "center", "label": "Centrée" } ],
      "default": "split"
    },
    { "type": "text", "id": "alt_text", "label": "Texte équivalent de la 3D (lecteurs d'écran)" },
    { "type": "text", "id": "caption", "label": "Légende sous le visuel (facultative)" }
  ],
  "presets": [ { "name": "KYMA — Ouverture de page" } ]
}
{% endschema %}
