{%- comment -%}
  KYMA — Les coloris du Drop 1 en bande horizontale (glissement doux, snap, boutons, clavier).
  Un bloc = un coloris : image (packshot), nom, description, lien, pastille de couleur.
{%- endcomment -%}
{% render 'kyma-assets' %}
{%- assign title_id = 'kyma-cw-title-' | append: section.id -%}

<section class="kyma-sec kyma-cw" aria-labelledby="{{ title_id }}">
  <div class="kyma-sec__inner kyma-cw__head">
    <div data-kyma-reveal>
      {% render 'kyma-section-head',
        number: section.settings.number,
        label: section.settings.label,
        before: section.settings.title_before,
        em: section.settings.title_em,
        after: section.settings.title_after,
        text: section.settings.text,
        heading_id: title_id
      %}
    </div>
    {%- if section.blocks.size > 1 -%}
      <div class="kyma-cw__nav" data-kyma-reveal>
        <button type="button" class="kyma-cw__arrow" data-kyma-scroll="-1" aria-label="Coloris précédents" disabled>
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true" focusable="false"><path d="M11 3 5 9l6 6"/></svg>
        </button>
        <button type="button" class="kyma-cw__arrow" data-kyma-scroll="1" aria-label="Coloris suivants">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true" focusable="false"><path d="m7 3 6 6-6 6"/></svg>
        </button>
      </div>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <div
      class="kyma-cw__scroller"
      data-kyma-carousel
      role="region"
      aria-label="{{ section.settings.label | default: 'Coloris' | escape }}"
      tabindex="0"
    >
      <ul class="kyma-cw__track" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign cname = block.settings.name
            assign dot = '#C8A2C8'
            if block.settings.swatch != blank
              assign dot = block.settings.swatch | color_to_hex
            endif
            assign alt_text = block.settings.image.alt
            if alt_text == blank
              assign alt_text = 'Hoodie KYMA coloris ' | append: cname
            endif
          -%}
          <li class="kyma-cw__item" style="--kd: {{ forloop.index0 | times: 90 }}ms;" data-kyma-reveal {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a class="kyma-cw__card" href="{{ block.settings.link }}">
            {%- else -%}
              <div class="kyma-cw__card">
            {%- endif -%}
              {%- if block.settings.image != blank -%}
                <div class="kyma-cw__media">
                  {{
                    block.settings.image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      widths: '320, 480, 640, 900',
                      sizes: '(min-width: 750px) 320px, 70vw',
                      alt: alt_text,
                      class: 'kyma-cw__img'
                  }}
                </div>
                {%- if block.settings.caption != blank -%}
                  <p class="kyma-caption">{{ block.settings.caption | escape }}</p>
                {%- endif -%}
              {%- else -%}
                <div class="kyma-cw__media kyma-cw__media--ph" style="--tile: {{ dot }};" aria-hidden="true"></div>
              {%- endif -%}
              <div class="kyma-cw__meta">
                <h3 class="kyma-cw__name">
                  <span class="kyma-cw__dot" style="--dot: {{ dot }};" aria-hidden="true"></span>
                  {{ cname | escape }}
                </h3>
                {%- if block.settings.description != blank -%}
                  <p class="kyma-cw__desc">{{ block.settings.description | escape }}</p>
                {%- endif -%}
                {%- if block.settings.link != blank and section.settings.link_label != blank -%}
                  <span class="kyma-cw__more">{{ section.settings.link_label | escape }}</span>
                {%- endif -%}
              </div>
            {%- if block.settings.link != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- elsif request.design_mode -%}
    <div class="kyma-sec__inner"><p class="kyma-sec__desc"><span class="kyma-todo">[À COMPLÉTER : ajouter un bloc « Coloris » par coloris du Drop 1]</span></p></div>
  {%- endif -%}

  {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
    <div class="kyma-sec__inner kyma-cw__foot" data-kyma-reveal>
      <a class="kyma-link" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label | escape }}</a>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "KYMA — Coloris",
  "tag": "div",
  "class": "kyma-section",
  "settings": [
    { "type": "text", "id": "number", "label": "Numéro", "default": "01" },
    { "type": "text", "id": "label", "label": "Label", "default": "Le Drop 1" },
    { "type": "text", "id": "title_before", "label": "Titre — début", "default": "Cinq coloris, un même" },
    { "type": "text", "id": "title_em", "label": "Titre — mot en italique", "default": "flux" },
    { "type": "text", "id": "title_after", "label": "Titre — fin (facultatif)", "default": "." },
    { "type": "textarea", "id": "text", "label": "Texte d'introduction", "default": "Lilac Whirl, Ivory Tide, Silver Drift, Noir Absolu, Crimson Flow. Cinq nuances du même mouvement, en petite série." },
    { "type": "text", "id": "link_label", "label": "Texte du lien sous chaque coloris", "default": "Découvrir" },
    { "type": "text", "id": "cta_label", "label": "Lien sous la bande — texte", "default": "Voir les coloris" },
    { "type": "url", "id": "cta_link", "label": "Lien sous la bande — URL" }
  ],
  "blocks": [
    {
      "type": "colorway",
      "name": "Coloris",
      "limit": 12,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (packshot, fond clair)" },
        { "type": "text", "id": "caption", "label": "Légende sous l'image (laisser vide pour une vraie photo du produit fabriqué)", "default": "Visuel de présentation (rendu) — chaque pièce ayant un motif unique, la vôtre sera différente." },
        { "type": "text", "id": "name", "label": "Nom du coloris", "default": "Lilac Whirl" },
        { "type": "text", "id": "description", "label": "Description courte" },
        { "type": "url", "id": "link", "label": "Lien (fiche produit ou variante)" },
        { "type": "color", "id": "swatch", "label": "Pastille / couleur de repli", "default": "#C8A2C8" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "KYMA — Coloris",
      "blocks": [
        { "type": "colorway", "settings": { "name": "Lilac Whirl", "description": "Lilas tourbillonnant sur poudre", "swatch": "#C8A2C8" } },
        { "type": "colorway", "settings": { "name": "Ivory Tide", "description": "Crème ivoire sur vanille", "swatch": "#EFE6D2" } },
        { "type": "colorway", "settings": { "name": "Silver Drift", "description": "Gris acier sur perle", "swatch": "#B9BDC4" } },
        { "type": "colorway", "settings": { "name": "Noir Absolu", "description": "Noir sur anthracite, marbrage subtil", "swatch": "#2B2B2E" } },
        { "type": "colorway", "settings": { "name": "Crimson Flow", "description": "Cramoisi sur bordeaux", "swatch": "#8E1B33" } }
      ]
    }
  ]
}
{% endschema %}
